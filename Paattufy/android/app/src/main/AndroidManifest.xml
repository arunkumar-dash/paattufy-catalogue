            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_6"
            android:label="Paattufy"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Launcher icon colourway 7 (runtime swap, AP §3.7b / TP §5.8) -->
        <activity-alias
            android:name=".IconAlias7"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_7"
            android:label="Paattufy"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Launcher icon colourway 8 (runtime swap, AP §3.7b / TP §5.8) -->
        <activity-alias
            android:name=".IconAlias8"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_8"
            android:label="Paattufy"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Home-screen widgets: small / medium / large (AP §6) -->
        <receiver android:name=".PlayerWidgetSmall" android:exported="true" android:label="Paattufy (small)">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/player_widget_small_info" />
        </receiver>
        <receiver android:name=".PlayerWidgetMedium" android:exported="true" android:label="Paattufy (medium)">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/player_widget_medium_info" />
        </receiver>
        <receiver android:name=".PlayerWidgetLarge" android:exported="true" android:label="Paattufy (large)">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/player_widget_large_info" />
        </receiver>
        <receiver android:name=".WidgetActionReceiver" android:exported="false" />

        <!-- Quick-settings tile -->
        <service
            android:name=".PlaybackTileService"
            android:exported="true"
            android:icon="@drawable/ic_stat_music"
            android:label="Paattufy"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
        </service>

        <!-- Android Auto: media app, browsable through the existing MediaBrowserService -->
        <meta-data android:name="com.google.android.gms.car.application" android:resource="@xml/automotive_app_desc" />

        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>

    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT" />
            <data android:mimeType="text/plain" />
        </intent>
        <intent>
            <action android:name="android.media.action.DISPLAY_AUDIO_EFFECT_CONTROL_PANEL" />
        </intent>
    </queries>
</manifest>
